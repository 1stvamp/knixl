# Shared look for every knixl demo. Sourced at the top of each tape.
Set Shell "bash"
Set FontFamily "Fira Mono"
Set FontSize 18
Set LineHeight 1.25
Set Width 1200
Set Height 700
Set Padding 28
Set Margin 0
Set BorderRadius 10
Set Theme "Catppuccin Mocha"
Set Framerate 24
Set TypingSpeed 45ms
Set CursorBlink false
Set WindowBar ""
# Every tape sleeps after its closing Screenshot: vhs 0.12.1 drops one issued as the last command.
