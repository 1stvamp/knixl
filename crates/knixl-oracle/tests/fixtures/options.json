{
  "services.nginx.enable": { "type": "boolean", "declarations": ["nixos/modules/services/web-servers/nginx"] },
  "services.nginx.virtualHosts.<name>.forceSSL": { "type": "boolean", "declarations": ["nginx"] },
  "services.nginx.virtualHosts.<name>.serverAliases": { "type": "list of string", "declarations": ["nginx"] },
  "system.stateVersion": { "type": "string", "readOnly": true, "declarations": ["nixos"] },
  "nix.settings": { "type": "open submodule of attribute set of (Nix config atom (null, bool, int, float, str, path or package) or list of (Nix config atom (null, bool, int, float, str, path or package)))", "declarations": ["nixos/modules/config/nix.nix"] },
  "nix.settings.cores": { "type": "signed integer", "declarations": ["nixos/modules/config/nix.nix"] },
  "nixpkgs.config": { "type": "nixpkgs config", "declarations": ["nixos/modules/misc/nixpkgs.nix"] },
  "home-manager.users": { "type": "attribute set of (Home Manager module)", "declarations": ["home-manager/nixos"] }
}
